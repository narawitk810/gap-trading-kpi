# Admin key สำหรับเข้าหน้า /admin (เปลี่ยนได้)
ADMIN_KEY=GAPtrading2024admin

# Google Sheets — ใส่ URL ของ Apps Script ที่ deploy แล้ว
# (ถ้าไม่ใส่ ระบบยังทำงานได้ปกติ แค่ไม่ sync Sheets)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxxxxxxxx/exec

# LINE Messaging API — แจ้งเตือนทีมไลฟ์สด/การตลาดเมื่อ Admin รับทราบโปรซื้อครบ
# (ถ้าไม่ใส่ ระบบยังทำงานได้ปกติ แค่ไม่ส่งแจ้งเตือน LINE)
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxx
LINE_GROUP_ID_LIVE=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_GROUP_ID_MARKETING=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_GROUP_ID_CREATIVE=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL ของเว็บ (ใช้แปะลิงก์ในข้อความแจ้งเตือน LINE) — ใส่ตอน deploy จริง
APP_BASE_URL=https://your-app.vercel.app
